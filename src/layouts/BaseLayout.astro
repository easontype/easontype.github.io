---
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  ogImage?: string;
}

const {
  title,
  description,
  noindex = false,
  ogType = "website",
  ogImage = "/og-default.png",
} = Astro.props;

const siteName = site.name;
const pageTitle = title === siteName ? `${siteName}｜${site.tagline}` : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const path = Astro.url.pathname;
const isActive = (prefix: string) => path === prefix || path.startsWith(`${prefix}/`);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  description: site.tagline,
  url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{pageTitle}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans+TC:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <slot name="head" />
    {
      site.goatcounterCode && (
        <script
          data-goatcounter={`https://${site.goatcounterCode}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
    <style is:global>
      :root {
        color-scheme: light;
        --canvas: #ffffff;
        --surface: #f6f8fb;
        --surface-soft: #fbfcfe;
        --primary-soft: #e7f2fb;
        --primary-tint: #cfe6f8;
        --ink: #14202e;
        --slate: #47566a;
        --steel: #737f92;
        --hairline: #e6ebf2;
        --hairline-strong: #d2dae5;
        --primary: #1668b0;
        --primary-pressed: #0f4f88;
        --on-primary: #ffffff;
        --accent: #2ea3e6;

        --font-display: "Space Grotesk", "IBM Plex Sans TC", sans-serif;
        --font-sans: "IBM Plex Sans TC", system-ui, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, monospace;

        --measure: 720px;
        --shell: 1320px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.7;
        overflow-x: hidden;
      }

      a {
        color: var(--primary);
        text-decoration: none;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        font-weight: 600;
        line-height: 1.2;
        margin: 0 0 0.5em;
      }

      .site-header {
        border-bottom: 1px solid var(--hairline);
        border-top: 2px solid var(--primary-tint);
      }

      .site-header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: var(--shell);
        margin: 0 auto;
        padding: 20px clamp(20px, 5vw, 32px);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 17px;
        color: var(--ink);
      }

      .brand svg {
        width: 22px;
        height: 22px;
        display: block;
      }

      .site-nav {
        display: flex;
        gap: 22px;
        font-size: 14px;
      }

      .site-nav a {
        color: var(--slate);
        padding: 4px 0 2px;
        border-bottom: 2px solid transparent;
        transition: color 160ms ease;
      }

      .site-nav a:hover {
        color: var(--primary);
      }

      .site-nav a.active {
        color: var(--primary);
        font-weight: 600;
        border-bottom-color: var(--accent);
      }

      main {
        max-width: var(--shell);
        margin: 0 auto;
        padding: 8px clamp(20px, 5vw, 32px) 64px;
      }

      .lede {
        color: var(--slate);
        font-size: 17px;
        max-width: 34em;
      }

      .text-link {
        color: var(--primary);
        transition: color 160ms ease;
      }

      .text-link:hover {
        color: var(--primary-pressed);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      time {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--steel);
      }

      .section-label {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-display);
        font-size: 20px;
        font-weight: 600;
        margin: 0 0 24px;
      }

      .section-label::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: 1.5px solid var(--accent);
        background: var(--primary-soft);
        flex-shrink: 0;
      }

      .tag-chip {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--primary);
        background: var(--primary-soft);
        border: 1px solid var(--primary-tint);
        border-radius: 999px;
        padding: 1px 9px;
        white-space: nowrap;
      }

      .site-footer {
        border-top: 1px solid var(--hairline);
      }

      .site-footer-inner {
        max-width: var(--shell);
        margin: 0 auto;
        padding: 28px clamp(20px, 5vw, 32px) 48px;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--steel);
      }

      .site-footer-links {
        display: flex;
        gap: 16px;
      }

      .site-footer a {
        color: var(--steel);
      }

      .site-footer a:hover {
        color: var(--primary);
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">
          <svg viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="9.5" stroke="#1668b0" stroke-width="1.5"></circle>
            <circle cx="11" cy="11" r="3" fill="#2ea3e6"></circle>
            <path d="M11 1.5v4M11 16.5v4M1.5 11h4M16.5 11h4" stroke="#cfe6f8" stroke-width="1.5"></path>
          </svg>
          <span>{siteName}</span>
        </a>
        <nav class="site-nav">
          <a href="/blog" class={isActive("/blog") ? "active" : ""}>文章</a>
          <a href="/projects" class={isActive("/projects") ? "active" : ""}>作品</a>
          <a href="/about" class={isActive("/about") ? "active" : ""}>關於</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <slot name="after-main" />
    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>© 2026 {siteName}</span>
        <span class="site-footer-links">
          <a href={site.githubUrl}>GitHub</a>
          {site.threadsUrl && <a href={site.threadsUrl}>Threads</a>}
          {site.portalyUrl && <a href={site.portalyUrl}>贊助我 (Portaly)</a>}
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>
