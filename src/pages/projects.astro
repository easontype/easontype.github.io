---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---

<style>
  .page-head {
    padding: 48px 0 32px;
  }

  .page-head h1 {
    font-size: clamp(28px, 4vw, 36px);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 14px;
    align-items: start;
  }

  .project-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 20px 24px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    align-items: baseline;
    transition: border-color 160ms ease;
  }

  .project-card:hover {
    border-color: var(--primary-tint);
  }

  .project-card h2 {
    font-size: 17px;
    margin: 0;
  }

  .project-card h2 a {
    color: var(--ink);
  }

  .project-card h2 a:hover {
    color: var(--primary);
  }

  .project-card p {
    color: var(--slate);
    margin: 0;
    font-size: 15px;
    grid-column: 1;
  }

  .gh-link {
    font-family: var(--font-mono);
    font-size: 12px;
    grid-row: 1 / span 2;
    grid-column: 2;
  }
</style>

<BaseLayout title="作品" description="AI八爪貓做過的工具與實驗專案，含 GitHub 原始碼連結。">
  <div class="page-head">
    <h1>作品</h1>
    <p class="lede">手上正在跑或做過的一些工具與實驗。有公開原始碼的附 GitHub 連結。</p>
  </div>
  <div class="project-grid">
    {
      projects.map((project) => (
        <article class="project-card">
          <h2>{project.href ? <a href={project.href}>{project.name}</a> : project.name}</h2>
          <p>{project.description}</p>
          {project.href && (
            <a class="gh-link text-link" href={project.href}>
              GitHub ↗
            </a>
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>
