---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "Social Drafts Dashboard",
    description: "社群貼文草稿管理儀表板。",
  },
  {
    name: "litereview",
    description: "文獻搜尋、找重點、比較的研究輔助工具。",
  },
  {
    name: "Lingua A8",
    description: "全雙工語音學習 app。",
  },
  {
    name: "Council",
    description: "學術 AI 討論／辯論框架與論文閱讀工具。",
  },
  {
    name: "Sports Betting ML",
    description: "運動賽事預測的機器學習專案。",
  },
  {
    name: "OctaBrain",
    description: "社群智慧引擎：分析貼文、學習主理人口吻。",
  },
  {
    name: "AI八爪貓 電子報",
    description: "AI 工具與趨勢的中文電子報。",
  },
];
---

<style>
  .page-head {
    padding: 48px 0 32px;
  }

  .project-grid {
    display: grid;
    gap: 14px;
  }

  .project-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 20px 24px;
    box-shadow: var(--shadow-subtle);
  }

  .project-card h2 {
    font-size: 17px;
    margin-bottom: 6px;
  }

  .project-card p {
    color: var(--slate);
    margin: 0;
    font-size: 15px;
  }
</style>

<BaseLayout title="作品" description="我做的一些專案與作品。">
  <div class="page-head">
    <h1>作品</h1>
    <p class="lede">手上正在跑或做過的一些工具與實驗。</p>
  </div>
  <div class="project-grid">
    {
      projects.map((project) => (
        <article class="project-card">
          <h2>{project.name}</h2>
          <p>{project.description}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
