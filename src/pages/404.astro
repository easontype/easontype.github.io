---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<style>
  .wrap-404 {
    padding: 96px 0;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--steel);
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(28px, 4vw, 36px);
  }
</style>

<BaseLayout title="找不到頁面" description="404：這頁不存在。" noindex>
  <div class="wrap-404">
    <p class="code">// 404 not found</p>
    <h1>這頁不存在。</h1>
    <p class="lede">可能是連結打錯了，或這篇內容搬家了。</p>
    <p><a class="text-link" href="/">← 回首頁</a></p>
  </div>
</BaseLayout>
