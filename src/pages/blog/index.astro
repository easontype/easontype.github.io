---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<style>
  .page-head {
    padding: 48px 0 24px;
  }

  .page-head h1 {
    font-size: clamp(28px, 4vw, 36px);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 0 72px;
    align-items: start;
  }

  .list-col {
    grid-column: 1;
    grid-row: 1;
  }

  .filter-col {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 40px;
  }

  .toolbar {
    display: grid;
    gap: 18px;
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel);
    margin: 0 0 8px;
  }

  .search {
    font: inherit;
    font-size: 14px;
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--hairline-strong);
    border-radius: 8px;
    color: var(--ink);
    background: var(--canvas);
  }

  .search::placeholder {
    color: var(--steel);
  }

  .search:focus {
    outline: 2px solid var(--primary-tint);
    outline-offset: 0;
    border-color: var(--primary);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--slate);
    background: var(--canvas);
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    padding: 3px 12px;
    cursor: pointer;
    transition: all 120ms ease;
  }

  .filter-chip:hover {
    border-color: var(--primary-tint);
    color: var(--primary);
  }

  .filter-chip.active {
    color: var(--primary);
    background: var(--primary-soft);
    border-color: var(--primary-tint);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 18px;
    padding: 20px 0;
    border-top: 1px solid var(--hairline);
  }

  .post-list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .post-list time {
    padding-top: 4px;
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
  }

  .post-title a {
    color: var(--ink);
  }

  .post-title a:hover {
    color: var(--primary);
  }

  .post-desc {
    color: var(--slate);
    font-size: 14px;
    margin-top: 4px;
  }

  .post-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .empty,
  .no-match {
    color: var(--steel);
    font-style: italic;
    padding: 24px 0;
  }

  .no-match {
    display: none;
  }

  @media (max-width: 960px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .list-col,
    .filter-col {
      grid-column: 1;
      grid-row: auto;
    }

    .filter-col {
      position: static;
      padding-bottom: 20px;
    }

    .search {
      max-width: 360px;
    }
  }

  @media (max-width: 560px) {
    .post-list li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>

<BaseLayout title="文章" description="AI八爪貓的所有文章：AI 工具、自動化實驗與技術筆記。">
  <div class="page-head">
    <h1>文章</h1>
    <p class="lede">全部文章，可用標題搜尋或標籤篩選。</p>
  </div>

  {
    posts.length === 0 ? (
      <p class="empty">還沒有文章，敬請期待。</p>
    ) : (
      <div class="blog-grid">
        <aside class="filter-col">
          <div class="toolbar">
            <div>
              <p class="filter-label">搜尋</p>
              <input class="search" id="post-search" type="search" placeholder="搜尋文章標題…" />
            </div>
            {allTags.length > 0 && (
              <div>
                <p class="filter-label">標籤</p>
                <div class="chips" id="tag-chips">
                  {allTags.map((tag) => (
                    <button class="filter-chip" type="button" data-tag={tag}>
                      {tag}
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>
        </aside>
        <div class="list-col">
          <ul class="post-list" id="post-list">
            {posts.map((post) => (
              <li
                class="post-item"
                data-title={post.data.title}
                data-tags={post.data.tags.join(",")}
              >
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toISOString().slice(0, 10)}
                </time>
                <div>
                  <div class="post-title">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </div>
                  <div class="post-desc">{post.data.description}</div>
                  {post.data.tags.length > 0 && (
                    <div class="post-tags">
                      {post.data.tags.map((tag) => (
                        <span class="tag-chip">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
          <p class="no-match" id="no-match">沒有符合的文章。</p>
        </div>
      </div>
    )
  }
</BaseLayout>

<script>
  // 前端篩選：搜尋框過濾標題（data-title），標籤 chip 單選過濾（data-tags）。
  const search = document.getElementById("post-search") as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-chip"));
  const items = Array.from(document.querySelectorAll<HTMLElement>(".post-item"));
  const noMatch = document.getElementById("no-match");
  let activeTag = "";

  function apply() {
    const q = (search?.value ?? "").trim().toLowerCase();
    let visible = 0;
    for (const item of items) {
      const title = (item.dataset.title ?? "").toLowerCase();
      const tags = (item.dataset.tags ?? "").split(",").filter(Boolean);
      const matchQ = !q || title.includes(q);
      const matchT = !activeTag || tags.includes(activeTag);
      const show = matchQ && matchT;
      item.style.display = show ? "" : "none";
      if (show) visible += 1;
    }
    if (noMatch) noMatch.style.display = visible === 0 ? "block" : "none";
  }

  search?.addEventListener("input", apply);
  for (const chip of chips) {
    chip.addEventListener("click", () => {
      const tag = chip.dataset.tag ?? "";
      activeTag = activeTag === tag ? "" : tag;
      for (const c of chips) c.classList.toggle("active", c.dataset.tag === activeTag);
      apply();
    });
  }
</script>
