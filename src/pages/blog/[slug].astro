---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterCta from "../../components/NewsletterCta.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  mainEntityOfPage: canonical.toString(),
  image: new URL("/og-default.png", Astro.site).toString(),
  author: {
    "@type": "Person",
    name: site.name,
    url: Astro.site?.toString(),
  },
};
---

<style>
  .post-head {
    padding: 48px 0 8px;
  }

  .post-head h1 {
    font-size: clamp(28px, 4vw, 38px);
    max-width: 20em;
  }

  .post-meta {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .prose {
    padding-top: 24px;
    line-height: 1.75;
    font-size: 17px;
  }

  .prose :global(p) {
    margin: 0 0 1.4em;
  }

  .prose :global(h2) {
    font-size: 24px;
    margin-top: 2em;
  }

  .prose :global(h3) {
    font-size: 19px;
    margin-top: 1.6em;
  }

  .prose :global(a) {
    color: var(--primary);
    border-bottom: 1px solid var(--primary-tint);
  }

  .prose :global(a:hover) {
    color: var(--primary-pressed);
    border-color: var(--primary);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    padding: 1px 6px;
  }

  .prose :global(pre) {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 16px;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .prose :global(blockquote) {
    margin: 0 0 1.4em;
    padding-left: 16px;
    border-left: 3px solid var(--primary-tint);
    color: var(--slate);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.4em;
    padding-left: 1.4em;
  }

  .prose :global(img) {
    max-width: 100%;
    border-radius: 8px;
  }

  .back {
    display: inline-block;
    margin-top: 40px;
  }
</style>

<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <div class="post-head">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toISOString().slice(0, 10)}
        </time>
        {post.data.tags.map((tag) => <span class="tag-chip">{tag}</span>)}
      </div>
      <h1>{post.data.title}</h1>
    </div>
    <div class="prose">
      <Content />
    </div>
    <NewsletterCta variant="card" />
    <a class="back text-link" href="/blog">← 回文章列表</a>
  </article>
</BaseLayout>
