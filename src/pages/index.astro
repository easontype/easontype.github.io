---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterCta from "../components/NewsletterCta.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 5);
const featured = projects.filter((p) => p.featured);
---

<style>
  .hero {
    position: relative;
    padding: 80px 0 64px;
    overflow: hidden;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary);
    margin: 0 0 14px;
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.14;
    margin: 0 0 16px;
    letter-spacing: -0.015em;
    position: relative;
    z-index: 1;
  }

  .hero p.lede {
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .trace {
    position: absolute;
    right: 0;
    top: 24px;
    z-index: 0;
    opacity: 0.7;
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 0 72px;
    align-items: start;
  }

  .section {
    padding: 36px 0;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--hairline);
    padding-top: 20px;
    margin-bottom: 24px;
  }

  .section-head .section-label {
    margin: 0;
  }

  .section-head a {
    font-size: 14px;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 26px;
  }

  .post-list li {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 18px;
  }

  .post-list time {
    padding-top: 3px;
  }

  .post-title {
    font-weight: 600;
    font-size: 16px;
  }

  .post-title a {
    color: var(--ink);
  }

  .post-title a:hover {
    color: var(--primary);
  }

  .post-desc {
    color: var(--slate);
    font-size: 14px;
    margin-top: 2px;
  }

  .empty {
    color: var(--steel);
    font-style: italic;
  }

  .side-cards {
    display: grid;
    gap: 12px;
  }

  .more-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 18px 18px 16px;
    display: grid;
    gap: 6px;
    align-content: start;
    transition: border-color 160ms ease;
  }

  .card:hover {
    border-color: var(--primary-tint);
  }

  .card .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
  }

  .card .name a {
    color: var(--ink);
  }

  .card .name a:hover {
    color: var(--primary);
  }

  .card .desc {
    color: var(--slate);
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .home-grid {
      grid-template-columns: 1fr;
    }

    .trace {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .post-list li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>

<BaseLayout title={site.name} description={`${site.tagline}。我是 AI八爪貓，一邊唸研究所，一邊用 Claude 和各種 agent 蓋工具，把過程寫下來。`}>
  <section class="hero">
    <svg class="trace" width="300" height="220" viewBox="0 0 300 220" fill="none" aria-hidden="true">
      <path d="M20 30 H120 V90 H210 V150 H290" stroke="#e7f2fb" stroke-width="2"></path>
      <path d="M60 200 V120 H150 V60 H250" stroke="#cfe6f8" stroke-width="2"></path>
      <circle cx="120" cy="90" r="5" fill="#e7f2fb" stroke="#cfe6f8" stroke-width="2"></circle>
      <circle cx="150" cy="60" r="5" fill="#ffffff" stroke="#2ea3e6" stroke-width="2"></circle>
      <circle cx="210" cy="150" r="5" fill="#e7f2fb" stroke="#cfe6f8" stroke-width="2"></circle>
      <circle cx="60" cy="200" r="4" fill="#cfe6f8"></circle>
      <circle cx="250" cy="60" r="4" fill="#2ea3e6" opacity="0.5"></circle>
    </svg>
    <p class="kicker">AI Tools · Automation · Build in Public</p>
    <h1>記錄 AI 工具、自動化實驗，<br />與一些技術筆記。</h1>
    <p class="lede">
      我是 AI八爪貓。一邊唸研究所，一邊用 Claude 和各種 agent 蓋工具，把踩過的雷和學到的事寫下來。
    </p>
  </section>

  <div class="home-grid">
    <section class="section">
      <div class="section-head">
        <h2 class="section-label">最新文章</h2>
        <a class="text-link" href="/blog">全部文章 →</a>
      </div>
      {
        latest.length === 0 ? (
          <p class="empty">還沒有文章，敬請期待。</p>
        ) : (
          <ul class="post-list">
            {latest.map((post) => (
              <li>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toISOString().slice(0, 10)}
                </time>
                <div>
                  <div class="post-title">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </div>
                  <div class="post-desc">{post.data.description}</div>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <aside class="section">
      <div class="section-head">
        <h2 class="section-label">精選作品</h2>
      </div>
      <div class="side-cards">
        {
          featured.map((project) => (
            <div class="card">
              <span class="name">
                {project.href ? <a href={project.href}>{project.name}</a> : project.name}
              </span>
              <span class="desc">{project.description}</span>
            </div>
          ))
        }
      </div>
      <a class="text-link more-link" href="/projects">全部作品 →</a>
    </aside>
  </div>

  <NewsletterCta slot="after-main" variant="band" />
</BaseLayout>
